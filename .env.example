# Copy this file to .env for local development.
# In production (Render), set these as actual Environment Variables in the
# dashboard instead of uploading a .env file.

# Get this from Supabase: Project Settings -> Database -> Connection string
# Use the "Connection pooling" URL (port 6543), not the direct one (port 5432) -
# Render's servers are ephemeral/serverless-ish and benefit from pgbouncer pooling.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].pooler.supabase.com:6543/postgres

# Generate a strong random value, e.g. run: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- eBay OAuth ---
# From developer.ebay.com -> Application Keys (use the Sandbox keyset while testing)
EBAY_CLIENT_ID=REPLACE_WITH_EBAY_APP_ID
EBAY_CLIENT_SECRET=REPLACE_WITH_EBAY_CERT_ID
# The "RuName" eBay generates when you register your redirect URL under
# User Tokens -> Add eBay Redirect URL. NOT the raw https:// URL itself.
EBAY_RU_NAME=REPLACE_WITH_EBAY_RUNAME
# SANDBOX while testing, PRODUCTION when going live
EBAY_ENVIRONMENT=SANDBOX

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Used to build the redirect URL back to the dashboard after eBay OAuth completes
FRONTEND_URL=http://localhost:5500
